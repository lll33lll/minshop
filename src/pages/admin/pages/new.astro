---
import AdminLayout from '../../../layouts/AdminLayout.astro';

const error = Astro.url.searchParams.get('error');
---

<AdminLayout title="新建页面" active="pages">
  <a href="/admin/pages" class="text-sm text-gray-500 hover:text-brand">&larr; 返回页面列表</a>
  <h1 class="mt-4 mb-6 font-serif text-3xl tracking-tight">新建页面</h1>

  {
    error && (
      <p class="mb-6 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
        {error}
      </p>
    )
  }

  {/* Step one of two: this creates an unpublished draft and redirects to the
      editor. Media can only be attached to a page that already has an id. */}
  <form method="POST" action="/api/admin/pages" class="max-w-xl">
    <label class="block text-xs uppercase tracking-widest text-gray-400">
      标题
      <input
        type="text"
        name="title"
        required
        maxlength="120"
        autofocus
        class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm normal-case tracking-normal text-gray-900 focus:border-brand focus:outline-none"
      />
    </label>

    <label class="mt-4 block text-xs uppercase tracking-widest text-gray-400">
      URL 标识 <span class="normal-case tracking-normal text-gray-400">（可选）</span>
      <input
        type="text"
        name="slug"
        placeholder="about"
        class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm normal-case tracking-normal text-gray-900 focus:border-brand focus:outline-none"
      />
      <span class="mt-1 block normal-case tracking-normal text-gray-400">
        留空则按标题自动生成，页面地址为 /pages/&lt;slug&gt;。
      </span>
    </label>

    <button
      type="submit"
      class="mt-6 rounded-md bg-brand px-4 py-2 text-xs font-medium uppercase tracking-wider text-white hover:bg-brand-hover"
    >
      存为草稿
    </button>
  </form>
</AdminLayout>
