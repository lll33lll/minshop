---
import type { StorefrontShellModel } from '../../features/storefront/models';

/**
 * STORE-OWNED. Edit freely — this file belongs to your store.
 *
 * Footer links come from the merchant's navigation menu, already filtered to
 * targets that are actually publishable, so nothing here can render a dead
 * link. Like the header, this renders on every page.
 */
interface Props {
  model: StorefrontShellModel;
}

const { model } = Astro.props;
---

<footer class="border-t border-line">
  <div
    class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-6 gap-y-3 px-6 py-10 text-xs uppercase tracking-widest text-muted"
  >
    <span>&copy; {model.storeName}</span>
    {
      model.footerLinks.length > 0 && (
        <nav aria-label="页脚导航" class="flex flex-wrap items-center gap-x-6 gap-y-3">
          {model.footerLinks.map((link) => (
            <a href={link.href} class="hover:text-brand">
              {link.text}
            </a>
          ))}
        </nav>
      )
    }
    {/* 在线客服（外部入口，店铺自有配置——想换地址改这里） */}
    <a href="https://edgechat.223226.xyz/register/c10100876af24e8ea842" target="_blank" rel="noopener" class="hover:text-brand">
      联系客服
    </a>
  </div>
</footer>
