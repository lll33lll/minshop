{
  // 本店实例配置（由 provision 渲染并提交；D1/R2 均已预建于 Cloudflare 账号）。
  // FREE-PLAN 默认：仅 D1 + R2。可选集成（Images、Workers AI + Vectorize、
  // Cloudflare Email）按需在下方注释区加 binding，缺失时功能自动降级。
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "minshop",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-07-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // 定时任务：释放过期库存预留、重试排队通知（handler: src/worker.ts）。
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": {
    "enabled": true,
    "traces": { "enabled": true, "head_sampling_rate": 1 }
  },
  // workers.dev 与自定义域名并存期间保持关闭；启用 cross_version_cache 需
  // CANONICAL_ORIGIN + workers_dev:false + CACHE_PURGE_SECRET。
  "cache": {
    "enabled": false
  },
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "10001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "CHECKOUT_RATE_LIMITER",
      "namespace_id": "10002",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "SEARCH_RATE_LIMITER",
      "namespace_id": "10003",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "minshop-db",
      "database_id": "e60fb1f4-43f2-41e6-87f6-486a1b79a429",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "minshop-images"
    },
    {
      // 私有数字商品文件：不要开 r2.dev，也不要绑自定义域名。
      "binding": "FILES",
      "bucket_name": "minshop-files"
    }
  ],
  "vars": {
    "STORE_NAME": "我的商店",
    "TIME_ZONE": "Asia/Shanghai",
    "CANONICAL_ORIGIN": "https://shop.223226.xyz"
  }
}
